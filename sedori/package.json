{
  "name": "ebay-sedori-manager",
  "version": "1.0.0",
  "description": "eBay輸出せどりのリサーチ・在庫・販売・月次管理アプリ",
  "main": "src/main.js",
  "author": "ryofssmax-a11y",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.example.ebaysedori",
    "productName": "eBayせどり管理",
    "files": ["src/**/*", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
